{
  "manifest_version": 3,
  "name": "Save to Word",
  "version": "1.0.0",
  "description": "Right-click selected text to save it to your Echo Word bank.",
  "permissions": ["contextMenus", "notifications", "storage"],
  "host_permissions": ["http://127.0.0.1:5050/*", "http://localhost:5050/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save to Word (select text → right-click)",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png"
  }
}
